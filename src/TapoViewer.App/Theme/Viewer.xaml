<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A video wall, not a dashboard. Chrome is deliberately quiet and low-chroma so the only
        saturated things on screen are the camera images and the few status colours that must be
        readable at a glance from across a room.

        Hard constraint shaping this design: a WPF HwndHost paints over everything WPF draws in
        its rectangle (airspace). No chrome may overlap the video — headers, controls and state
        panels all live outside the video rect.
    -->

    <!-- Ground and surfaces -->
    <SolidColorBrush x:Key="Bg" Color="#0A0B0D" />
    <SolidColorBrush x:Key="BarBg" Color="#101216" />
    <SolidColorBrush x:Key="PaneBg" Color="#0E0F12" />
    <SolidColorBrush x:Key="PaneChrome" Color="#14161B" />
    <SolidColorBrush x:Key="Line" Color="#22252D" />
    <SolidColorBrush x:Key="LineStrong" Color="#2E3440" />
    <SolidColorBrush x:Key="Control" Color="#191C22" />
    <SolidColorBrush x:Key="ControlHover" Color="#232830" />

    <!-- Ink -->
    <SolidColorBrush x:Key="Ink" Color="#E8EAF0" />
    <SolidColorBrush x:Key="InkMuted" Color="#7C8598" />
    <SolidColorBrush x:Key="InkFaint" Color="#565E6E" />

    <!-- Signal colours. Used sparingly: these are the only saturated chrome on screen. -->
    <SolidColorBrush x:Key="Accent" Color="#4C8DF6" />
    <SolidColorBrush x:Key="Live" Color="#35C46B" />
    <SolidColorBrush x:Key="Motion" Color="#F5A524" />
    <SolidColorBrush x:Key="Danger" Color="#E5484D" />

    <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Type ramp -->
    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="T.Muted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
    </Style>
    <Style x:Key="T.Micro" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
    </Style>

    <!-- Command-bar button -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="C"
                            Background="{StaticResource Control}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="11,6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="C" Property="Background" Value="{StaticResource ControlHover}" />
                            <Setter TargetName="C" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="C" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="C" Background="{StaticResource Accent}" CornerRadius="6" Padding="12,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="C" Property="Background" Value="#5E9BFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented layout selector -->
    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Square-ish padding: the content is now a glyph, not a text label. -->
                    <Border x:Name="C" Background="Transparent" CornerRadius="5" Padding="8,6" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="C" Property="Background" Value="{StaticResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="C" Property="Background" Value="{StaticResource ControlHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square icon button used in pane chrome -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="C" Background="Transparent" CornerRadius="5">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource Icons}"
                                   FontSize="12"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="C" Property="Background" Value="{StaticResource ControlHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PTZ key: text glyph, no chrome until hovered -->
    <Style x:Key="PtzKey" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="1,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="C" Background="Transparent" CornerRadius="4">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontSize="9"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="C" Property="Background" Value="{StaticResource ControlHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Fully retemplated. The stock ComboBox is a white Aero control: on this ground the closed
        box reads as a bright rectangle and the open list is white-on-white, so the preset names
        are effectively invisible. Nothing short of replacing the template fixes that, because
        the popup chrome ignores Background/Foreground.
    -->
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="C" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="C" Property="Background" Value="{StaticResource ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="C" Property="Background" Value="#12345E" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="B"
                                            Background="{StaticResource Control}"
                                            BorderBrush="{StaticResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            SnapsToDevicePixels="True">
                                        <Path x:Name="Chevron"
                                              Data="M 0 0 L 3.5 3.5 L 7 0"
                                              Stroke="{StaticResource InkMuted}"
                                              StrokeThickness="1.3"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,1,8,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{StaticResource ControlHover}" />
                                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Ink}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selection"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="9,0,22,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          TextElement.Foreground="{StaticResource Ink}" />

                        <!-- Without this the control is a blank box until something is chosen. -->
                        <TextBlock x:Name="Hint"
                                   Text="Preset"
                                   Margin="9,0,22,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Ui}"
                                   FontSize="11"
                                   Foreground="{StaticResource InkFaint}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               VerticalOffset="3"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="#161A21"
                                    BorderBrush="{StaticResource LineStrong}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="240">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status pill (MOTION, HD/SD) -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Background" Value="{StaticResource Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
